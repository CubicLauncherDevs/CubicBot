# Copia este archivo como .env y completa los valores.
DISCORD_TOKEN=
GUILD_ID=

# Canal para los mensajes de bienvenida. Vacío desactiva los mensajes.
WELCOME_CHANNEL_ID=

# Canal de Discord para los anuncios de temas y /ultimotema.
# Vacío desactiva los avisos automáticos.
THEMES_CHANNEL_ID=
# Intervalo en segundos (mínimo 30).
THEMES_POLL_SECONDS=300

# Opcional: sistema de tickets.
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=
TICKET_LOG_CHANNEL_ID=
TICKET_PANEL_CHANNEL_ID=

RUST_LOG=cubicbot=info
